# ailang 환경변수 — 이 파일이 키 목록의 진실이다 (docs/DATA_CONTRACT.md §6)
#
# 사용법:  cp .env.example .env  후 값을 채운다.
# ⚠️ .env 자체는 커밋하지 않는다(.gitignore). 값은 사용자가 직접 채운다 — Claude 가 쓰지 않는다.
#
# 🔴 **주석은 반드시 `#` 로 단다. `;` 는 안 된다.**
#    IDE 에서 전체 선택 후 「주석 처리」(Ctrl+/)를 누르면 `; ` 가 붙는데,
#    그러면 docker compose 가 파일 전체를 거부한다 (2026-09-01 실측):
#        failed to read .env: line 26: unexpected character ";" in variable name
#    ⚠️ 이미 떠 있는 컨테이너는 시작 시점 값을 갖고 있어 멀쩡해 보인다.
#       그래서 **재시작하는 순간**에야 깨진다.
#
# ─────────────────────────────────────────────────────────────────────────────
# 🔴 이 파일 하나를 **두 서버가 같이 읽는다.**
# ─────────────────────────────────────────────────────────────────────────────
#   · Spring Boot   springboot4-dotenv 가 이 파일을 읽어 application.yml 의 ${...} 를 채운다
#   · FastAPI       docker-compose.yml 의 `env_file: ./.env` 로 컨테이너 환경변수가 된다
#
# 🎯 그래서 **같은 이름인데 두 서버에 필요한 값이 다른 키가 있다.** 아래 ⑤번을 반드시 읽을 것.


# ── ① Oracle DB (Spring 전용) ────────────────────────────────────────────────
#
# docker-compose 의 oracle23ai 컨테이너. 접속 문자열은 application.yml 에 고정돼 있다:
#   jdbc:oracle:thin:@localhost:1521/FREEPDB1
# ⚠️ 컨테이너의 SYS 비밀번호(ORACLE_PASSWORD)와 이 계정은 다른 것이다.
#    이 계정은 컨테이너 기동 후 직접 만든다.
DB_USERNAME=
DB_PASSWORD=


# ── ② JWT (🔴 두 서버가 같은 값을 써야 한다) ──────────────────────────────────
#
# Spring 이 토큰을 만들고 FastAPI 가 같은 시크릿으로 검증한다(HS256).
# 🔴 **값이 다르면 개념 설명·모의문제·챗봇이 전부 401 이 된다.** 증상이 「AI 만 안 된다」로
#    나타나서 원인을 찾는 데 오래 걸린다.
# ⚠️ HS256 이므로 최소 32바이트 이상. 예시값(`your...`)을 그대로 두지 않는다.
JWT_SECRET=


# ── ③ Google — 소셜 로그인 · 메일 발송 (Spring 전용) ─────────────────────────
#
# 🧭 서로 다른 두 가지다. 이름이 비슷해서 섞이기 쉽다.
#    · CLIENT_ID / SECRET_KEY  → OAuth2 로그인 (Google Cloud Console)
#    · EMAIL / EMAIL_SECRET_KEY → 이메일 인증코드 발송 (Gmail 앱 비밀번호)
#
# 승인된 리디렉션 URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_KEY=

# Gmail 계정과 **앱 비밀번호**(계정 로그인 비밀번호가 아니다. 2단계 인증 후 발급)
GOOGLE_EMAIL=
GOOGLE_EMAIL_SECRET_KEY=


# ── ④ LLM (FastAPI 전용) — OpenAI 호환 엔드포인트라면 무엇이든 ───────────────
#
# 🔄 2026-09-01: langchain-google-genai → langchain_openai 로 바꿨다.
#    제공자를 코드에 묶지 않았으므로 **아래 세 값만 바꾸면 갈아탄다.**
#    🔴 GitHub Models 를 붙이려다 실패했다 — 2026-07-30 에 **완전히 종료**됐다
#       (410 Gone). 그래서 이름을 provider 중립으로 뒀다. → ai-call-policy.md §0.5
#
# 세 값 다 필수다. 안 적으면 서버가 뜨지 않는다 — 어느 모델을 쓰는지는
# 조용히 기본값으로 정할 일이 아니기 때문이다.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 조합 예시 (셋 다 무료 등급이 있다. 🔴 어디로 갈지는 사용자가 정한다)
#
#   Google AI Studio (기존 Gemini 키를 그대로 쓸 수 있다)
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#     LLM_MODEL=gemini-2.5-flash
#
#   Groq (빠르다)
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=llama-3.3-70b-versatile
#
#   OpenRouter (여러 모델을 한 키로, :free 접미사)
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODEL=<제공자>/<모델>:free
#
# ⚠️ **무료 등급은 어디든 한도가 낮다.** 그래서 아래 둘이 «나중에»가 아니라 지금 할 일이다:
#      · 사용자별 호출 상한 (없으면 한 사람이 하루치를 다 태운다) → 아직 없음
#      · 챗봇 이력 상한 (없으면 입력 한도를 넘겨 대화가 통째로 실패) → ✅ 코드에 반영됨
#    → TODOS.md 3절
#
# 안 적으면 코드의 기본값을 쓴다.
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=1


# ── ⑤ Redis — 🔴 여기를 채우면 오히려 깨진다 ─────────────────────────────────
#
# 두 서버가 **같은 Redis 를 서로 다른 주소로** 본다.
#   · Spring (호스트에서 실행)  → localhost:6380   ← compose 가 6380 으로 매핑했다
#   · FastAPI (컨테이너 안)     → ailang-redis:6379 ← 같은 네트워크 안의 이름
#
# 🔴 **REDIS_HOST / REDIS_PORT 를 여기 적지 않는다.** 이 파일은 두 서버가 같이 읽으므로,
#    Spring 을 위해 `REDIS_HOST=localhost` 를 넣는 순간 컨테이너의 FastAPI 도 그 값을 받아
#    자기 자신에게 붙으려다 실패한다(pydantic-settings 는 대소문자를 구분하지 않는다).
#    양쪽 다 코드에 올바른 기본값이 있으므로 **비워 두는 것이 정답이다.**
#
# 🧭 굳이 바꿔야 한다면 이름을 분리해야 한다 (예: SPRING_REDIS_HOST / AI_REDIS_HOST).
#    그건 값이 아니라 설계 변경이므로 TODOS.md 8절에 올리고 정한다.
#
# 🔴 REDIS_PASSWORD 는 «채워야 한다» (2026-09-15 부터).
#    docker-compose 가 이 값을 redis 의 requirepass 로 넘기고, Spring 과 FastAPI 가
#    둘 다 같은 값으로 붙는다. 비워 두면 redis 는 예전처럼 «인증 없이» 뜬다 —
#    거기엔 리프레시 토큰 원문(7일 유효)과 로그아웃 블랙리스트가 들어 있다.
#    ⚠️ 값을 바꾸면 `docker compose up -d redis` 로 컨테이너를 다시 만들어야 적용된다.
#       이미 떠 있는 컨테이너는 시작 시점 값을 갖고 있어 멀쩡해 보인다.
REDIS_PASSWORD=


# ── ⑥ 서버 간 주소 (Spring 전용) ─────────────────────────────────────────────
#
# Spring 이 FastAPI 를 부르는 주소. 기본값은 http://localhost:8001 (코드에 있다).
# 스프링도 컨테이너로 올리게 되면 http://ailang-ai-server:8000 으로 바뀐다.
# AI_SERVER_URL=


# ── ⑦ 기출문제 적재 경로 (Spring 전용) ───────────────────────────────────────
#
# 🔴 첫 기동 때 DataLoader 가 이 폴더의 JSON 을 읽어 PROBLEMS 표를 채운다.
#    **경로가 틀리면 에러가 아니라 경고 로그만 남고 문제 0건으로 뜬다.**
#    기동 로그에서 `[DataLoader] 적재 완료 - 삽입: N개` 의 N 을 반드시 확인할 것.
#
# ⚠️ 이 값이 예전에 application.yml 에 절대 경로로 박혀 있었다
#    (C:/Users/USER/OneDrive/Desktop/...). 다른 사람이 클론하면 무조건 0건이었다.
#    자료 구조: docs/research/aihub-json-structure.md
#
# 🧭 Windows 에서도 슬래시(/)를 쓴다. 역슬래시는 이스케이프로 먹힌다.
DATA_PROBLEM_DIR=
DATA_ANSWER_DIR=

# 적재를 끄려면 false. (이미 적재됐으면 코드가 알아서 건너뛴다 — 끌 필요는 없다)
# DATA_LOADER_ENABLED=true


# ── ⑧ 프론트엔드 출처 (Spring 전용) ──────────────────────────────────────────
#
# CORS 허용 출처이자 OAuth2 로그인 성공 후 돌려보낼 주소.
# 프론트엔드 코드는 C:\webStorm_workspace\ailang 에 있다 (별도 폴더, 이 레포 아님).
#
# 🔄 **2026-09-15: 아래 두 값이 실제로 «읽히게» 됐다.** 예전에는 프론트 주소가
#    SecurityConfig 의 CORS 허용 출처와 application.yml 의 리다이렉트 주소에 각각
#    문자열로 박혀 있었다. 한 곳만 고치면 「로그인은 되는데 화면이 못 받는」 상태가 된다.
#    이제 두 곳이 같은 APP_FRONTEND_ORIGIN 을 본다.
#
#   APP_FRONTEND_ORIGIN  → CORS 허용 출처 + 로그인 후 돌아갈 주소(뒤에 /oauth2/callback)
#                          쉼표로 여러 개를 줄 수 있다
#   APP_BACKEND_ORIGIN   → 🔴 백엔드 «자신» 의 구글 콜백 주소. 성격이 다르다 —
#                          이 값은 구글 클라우드 콘솔의 「승인된 리디렉션 URI」와
#                          **글자 하나까지 같아야** 한다. 여기만 바꾸면 로그인이 깨진다
#
# ⚠️ 아직 리터럴로 남아 있는 것 (이번 작업 범위 밖):
#   application.yml  jdbc:...@localhost:1521/FREEPDB1  ← 계정·비번은 환경변수인데 주소만 리터럴
#   application.yml  smtp.gmail.com
# 🧭 CLAUDE.md 가 경계하는 「설정이 다섯 곳에 반복된다」가 이 모습이다 — 고쳤다고
#    믿기 전에 grep 할 것.
# APP_FRONTEND_ORIGIN=http://localhost:5173
# APP_BACKEND_ORIGIN=http://localhost:8080


# ── ⑨ 인증 메일 상한 (Spring 전용) ───────────────────────────────────────────
#
# 🔴 2026-09-15 이전에는 상한이 **하나도 없었다.** 로그인 없이 부를 수 있는
#    /api/auth/email/send 로 임의 주소에 메일을 무한히 쏠 수 있었고, 6자리 인증코드는
#    맞을 때까지 넣어 볼 수 있었다.
#
# ⚠️ **아래 값은 잠정값이다** — 「몇 번 틀리면 잠그나」·「한 주소에 몇 통까지」는
#    사용자가 정할 일이다 (TODOS.md 8절). 정해지면 이 세 줄만 바꾸면 된다.
#
# MAIL_MAX_SEND_PER_WINDOW=5     # 한 주소에 창 하나당 보낼 수 있는 메일 수
# MAIL_SEND_WINDOW_SECONDS=3600  # 위 상한을 세는 창의 길이(초)
# MAIL_MAX_VERIFY_ATTEMPTS=5     # 코드 하나에 허용하는 입력 횟수. 넘으면 코드를 버린다


# ── ⑩ 개발용 스위치 ──────────────────────────────────────────────────────────
#
# 🔴 운영에서 켜지 않는다. 켜면 SQL 전문이 로그에 찍히고, 거기에는 학생 이메일과
#    제출한 답안이 그대로 들어간다. 기본값은 false 다.
# JPA_SHOW_SQL=false


# ─────────────────────────────────────────────────────────────────────────────
# ⬜ 아직 안 쓰임 — Phase 3(RAG) 에서 의미가 생긴다
# ─────────────────────────────────────────────────────────────────────────────
#
# 🔄 2026-09-01 해결됨 — 비워 둬도 된다.
#    예전엔 이 둘이 **필수 필드**라서, 읽는 코드가 한 줄도 없는데도 값이 없으면
#    FastAPI 가 아예 안 떴다. `config.py` 에서 선택 필드로 바꿨고
#    `requirements.txt` 의 supabase 패키지도 주석 처리했다 —
#    설치돼 있으면 「이미 구현돼 있다」고 오해하게 만들기 때문이다.
#    Phase 3(RAG) 에서 되살린다. → TODOS.md 6절
#
# ⚠️ SUPABASE_PUBLISHABLE_API_KEY 는 코드가 읽지 않는다. 이름이 비슷한 SECRET_KEY 쪽만 읽는다.
# SUPABASE_PROJECT_URL=
# SUPABASE_PUBLISHABLE_SECRET_KEY=
